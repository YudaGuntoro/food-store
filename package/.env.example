# Store WhatsApp number with country code. Empty = preview checkout only.
NEXT_PUBLIC_STORE_WHATSAPP=

# Social usernames without URLs (with or without @) and contact email.
NEXT_PUBLIC_STORE_INSTAGRAM=
NEXT_PUBLIC_STORE_TIKTOK=
NEXT_PUBLIC_STORE_EMAIL=

# Midtrans Sandbox only. Server-side secret; never use NEXT_PUBLIC_ for this key.
# Retrieve from Midtrans dashboard in Sandbox mode > Settings > Access Keys.
MIDTRANS_SERVER_KEY=
