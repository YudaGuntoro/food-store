# Copy to .env in the repository root ON THE VPS. This file contains no secrets.
# Host port for the existing reverse proxy (Nginx/Caddy/etc.).
FOODSTORE_PORT=3101

# Runtime secret: use a Midtrans Sandbox Server Key starting with SB-Mid-server-.
MIDTRANS_SERVER_KEY=

